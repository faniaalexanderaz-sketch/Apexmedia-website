{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/donna", "destination": "/donna.html" },
    { "source": "/uomo", "destination": "/uomo.html" },
    { "source": "/curvy", "destination": "/curvy.html" },
    { "source": "/negozio", "destination": "/negozio.html" },
    { "source": "/cassa", "destination": "/checkout.html" },
    { "source": "/prodotto/:slug", "destination": "/prodotto.html?p=:slug" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/foto/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
