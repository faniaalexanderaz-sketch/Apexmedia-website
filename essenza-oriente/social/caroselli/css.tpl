
@font-face{font-family:'Cormorant';font-weight:600;src:url(data:font/woff2;base64,%s) format('woff2')}
@font-face{font-family:'Cormorant';font-weight:500;font-style:italic;src:url(data:font/woff2;base64,%s) format('woff2')}
@font-face{font-family:'Jost';font-weight:100 900;src:url(data:font/woff2;base64,%s) format('woff2-variations')}
*{margin:0;padding:0;box-sizing:border-box}
body{width:1080px;height:1350px;overflow:hidden;background:#17271c;font-family:'Jost',sans-serif;color:#fff}
.s{position:relative;width:1080px;height:1350px;overflow:hidden}
.bg{position:absolute;inset:0;width:100%%;height:100%%;object-fit:cover}
.top{position:absolute;inset:0;background:linear-gradient(180deg,rgba(23,39,28,.88) 0%%,rgba(23,39,28,.55) 32%%,rgba(23,39,28,0) 60%%)}
.bot{position:absolute;inset:0;background:linear-gradient(0deg,rgba(23,39,28,.92) 0%%,rgba(23,39,28,.6) 38%%,rgba(23,39,28,0) 65%%)}
.brand{position:absolute;left:64px;top:56px;display:flex;align-items:center;gap:16px}
.brand .dot{width:52px;height:52px;border-radius:50%%;background:#B99A45;color:#16220f;font-family:'Cormorant';font-weight:600;font-size:34px;display:flex;align-items:center;justify-content:center}
.brand .t{font-family:'Cormorant';font-weight:600;font-size:40px;line-height:1}
.brand .u{font-size:20px;letter-spacing:.18em;text-transform:uppercase;color:#D9C68C;margin-top:4px;font-weight:600}
.pg{position:absolute;right:64px;top:70px;font-size:24px;letter-spacing:.2em;color:#D9C68C;font-weight:600}
.eyebrow{display:inline-block;font-size:24px;letter-spacing:.22em;text-transform:uppercase;color:#D9C68C;font-weight:700;border:2px solid rgba(217,198,140,.7);border-radius:999px;padding:12px 26px;margin-bottom:28px}
.h{font-family:'Cormorant';font-weight:600;font-size:118px;line-height:.98;letter-spacing:-.01em}
.h em{font-style:italic;font-weight:500;color:#D9C68C}
.p{font-size:36px;line-height:1.35;font-weight:400;color:#F3EBD6;margin-top:28px;max-width:900px}
.block{position:absolute;left:64px;right:64px}
.block.topb{top:200px}.block.botb{bottom:120px}
.list{display:flex;flex-direction:column;gap:18px;margin-top:34px}
.li{display:flex;align-items:center;gap:20px;font-size:36px;font-weight:600;color:#fff}
.li i{width:48px;height:48px;border-radius:50%%;background:#B99A45;display:flex;align-items:center;justify-content:center;flex:none}
.li i svg{width:28px;height:28px;stroke:#16220f;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
.cta{display:inline-flex;align-items:center;gap:18px;background:#B99A45;color:#16220f;font-weight:700;font-size:42px;padding:28px 56px;border-radius:999px;margin-top:40px}
.cta svg{width:40px;height:40px;stroke:#16220f;fill:none;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
.url{font-size:40px;font-weight:700;letter-spacing:.02em;margin-top:26px;color:#fff}
.addr{font-size:26px;letter-spacing:.08em;color:#D9C68C;margin-top:10px;font-weight:600}
.swipe{position:absolute;right:64px;bottom:64px;display:flex;align-items:center;gap:12px;font-size:26px;letter-spacing:.14em;text-transform:uppercase;color:#D9C68C;font-weight:700}
.swipe svg{width:34px;height:34px;stroke:#D9C68C;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
.topl{position:absolute;inset:0;background:linear-gradient(180deg,rgba(23,39,28,.72) 0%,rgba(23,39,28,0) 22%)}
.botl{position:absolute;inset:0;background:linear-gradient(0deg,rgba(23,39,28,.7) 0%,rgba(23,39,28,0) 18%)}
