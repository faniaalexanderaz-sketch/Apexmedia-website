# Vercel Postgres: la variabile arriva da sola collegando il database al progetto (Storage > Postgres).
POSTGRES_URL=

# Resend: notifica email per ogni lead.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Mittente su dominio verificato in Resend. Se vuoto usa onboarding@resend.dev (solo test).
RESEND_FROM=

# Dominio definitivo, senza barra finale. Serve a sitemap e link canonici.
NEXT_PUBLIC_SITE_URL=

# Tracciamento (facoltativi). Se GA è impostato compare il banner dei cookie.
NEXT_PUBLIC_GA_ID=
# Conversione Google Ads nel formato AW-123456789/AbCdEfGhIj
NEXT_PUBLIC_ADS_CONVERSIONE=
