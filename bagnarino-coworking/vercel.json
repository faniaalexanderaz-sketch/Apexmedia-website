{
  "regions": [
    "fra1"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?file=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo?file=robots"
    },
    {
      "source": "/api/prenotazione",
      "destination": "/api/cliente?azione=stato"
    },
    {
      "source": "/api/annulla",
      "destination": "/api/cliente?azione=annulla"
    },
    {
      "source": "/api/vantaggi",
      "destination": "/api/cliente?azione=vantaggi"
    },
    {
      "source": "/api/card",
      "destination": "/api/cliente?azione=card"
    },
    {
      "source": "/gestione",
      "destination": "/api/gestione?pagina=app"
    },
    {
      "source": "/gestione/:pagina",
      "destination": "/api/gestione?pagina=:pagina"
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/prezzi",
      "destination": "/#prezzi",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/gestione",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw-gestione.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/gestione"
        }
      ]
    },
    {
      "source": "/gestione.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/gestione(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?compito=promemoria",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron?compito=riepilogo",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/cron?compito=report",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "49 7 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "56 8 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "3 9 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "10 10 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "17 11 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "24 12 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "31 13 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "38 14 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "45 15 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "52 16 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "59 17 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "6 18 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "13 19 * * *"
    },
    {
      "path": "/api/cron?compito=attese",
      "schedule": "20 20 * * *"
    }
  ]
}
