# ============================================================
# Essenza d'Oriente — Traffic Dashboard — variabili d'ambiente
# Copia questo file in .env.local per lo sviluppo locale.
# In produzione (Vercel) vanno impostate nel pannello del progetto.
# ============================================================

# Password per accedere alla dashboard (password gate semplice).
# Sceglila tu: è la password che il team/cliente userà per entrare.
DASHBOARD_PASSWORD=

# ID della proprietà GA4 di essenzadoriente.it (solo numero, senza "properties/").
# Si trova in Google Analytics > Amministrazione > Dati proprietà > Dettagli proprietà.
GA4_PROPERTY_ID=

# Email del service account Google Cloud creato per l'accesso alla Data API.
# Esempio: essenza-dashboard@nome-progetto.iam.gserviceaccount.com
# Vedi SETUP.md per come crearlo.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Chiave privata del service account (dal file JSON scaricato da Google Cloud).
# Copiala includendo "-----BEGIN PRIVATE KEY-----" e "-----END PRIVATE KEY-----",
# con i newline sostituiti da \n (letterale, due caratteri: backslash + n).
# Se la incolli su Vercel come variabile multi-riga, puoi anche lasciarla con
# newline reali: il codice gestisce entrambi i casi.
GOOGLE_PRIVATE_KEY=
