{
  "name": "apex-media-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:sql": "rm -rf drizzle && DB_LOCAL_DIR=./.pglite drizzle-kit generate --name schema && node -e \"const fs=require('fs');const f=fs.readdirSync('drizzle').find(x=>x.endsWith('.sql'));fs.writeFileSync('src/db/schema.sql.ts','/* Generato da npm run db:sql a partire da src/db/schema.ts: usato solo dalla modalit\u00e0 demo (PGlite in memoria). Non modificare a mano. */\\nexport const SCHEMA_SQL = '+JSON.stringify(fs.readFileSync('drizzle/'+f,'utf8'))+';\\n')\" && rm -rf drizzle"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/postgres": "^0.10.0",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
