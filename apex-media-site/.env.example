# Dashboard click /admin — tutto su Vercel, nessun servizio esterno
ADMIN_PASSWORD=                 # password dell'area riservata (già impostata su Vercel)
BLOB_READ_WRITE_TOKEN=          # la aggiunge Vercel da solo collegando un Blob store al progetto (Storage → Blob)
BLOB_ACCESS=private             # 'public' solo se lo store è stato creato pubblico
TRACK_ALLOWED_ORIGINS=          # opzionale: altre origini separate da virgola, es. https://altrocliente.it

# Già previste dal sito (opzionali)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
