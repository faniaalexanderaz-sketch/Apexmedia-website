# Database: Vercel Postgres. Le variabili POSTGRES_* le genera Vercel collegando
# il database al progetto (Storage → Postgres → Connect). In locale: `vercel env pull`.
POSTGRES_URL=

# Pannello /admin e /jenny
ADMIN_PASSWORD=
CLIENT_PASSWORD=

# Opzionali
TRACK_ALLOWED_ORIGINS=          # altre origini separate da virgola, es. https://altrocliente.it
DB_LOCAL_DIR=                   # solo sviluppo senza database: cartella per PGlite (Postgres locale)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
